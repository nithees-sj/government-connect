FROM node:20-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace definition files
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* .pnpmrc.yaml* ./
COPY packages ./packages
COPY apps/mock-departments ./apps/mock-departments

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Expose ports for Dept A (9001), Dept B (9002), Dept C (9003), and Simulation Gateway (9000)
EXPOSE 9000 9001 9002 9003

# Start Mock Departments
CMD ["npx", "tsx", "apps/mock-departments/src/index.ts"]
