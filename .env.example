# ─── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ─── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://govconnect_app:govconnect_app_2024@localhost:27017/govconnect

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=govconnect-access-secret-change-in-production
JWT_REFRESH_SECRET=govconnect-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Mock Departments ────────────────────────────────────
DEPT_A_URL=http://localhost:9001
DEPT_B_URL=http://localhost:9002
DEPT_C_URL=http://localhost:9003

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
